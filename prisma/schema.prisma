// Prisma schema — MVP normalized data model.
// See docs/PROJECT_PROPOSAL.md for the full architecture rationale.
//
// Design notes:
// - Every provider-sourced row carries `provider` + `externalId` (unique
//   together) so ingestion can upsert safely and a second provider can be
//   added later without changing the shape of these fields.
// - PostgreSQL, used for both local development and production (see
//   lib/db/client.ts and prisma.config.ts) — the schema was deliberately
//   kept free of SQLite-only features from the start, so this was a
//   provider-string swap, not a data-model rewrite.
// - No persisted "analytics results" table yet — the current dataset is
//   small enough to compute rankings/scores on read. See
//   lib/analytics/scoring for that layer.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Competition {
  id       String    @id @default(cuid())
  provider String
  code     String // e.g. "premier-league"
  name     String
  seasons  Season[]
  teams    Team[]
  players  Player[]
  matches  Match[]

  @@unique([provider, code])
}

model Season {
  id            String      @id @default(cuid())
  provider      String
  externalId    String // provider's identifier for this season, if any
  label         String // e.g. "2026/27"
  isCurrent     Boolean     @default(false)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  matches       Match[]

  @@unique([provider, externalId])
  @@index([competitionId])
}

model Team {
  id            String      @id @default(cuid())
  provider      String
  externalId    String // provider's team id
  name          String
  shortName     String
  /// Provider's crest asset code (see lib/assets) — an identity/imagery
  /// field, not an analytical statistic.
  crestCode     Int?
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])

  players       Player[]
  homeMatches   Match[]                @relation("HomeTeam")
  awayMatches   Match[]                @relation("AwayTeam")
  performances  TeamMatchPerformance[]
  newsItems     NewsItem[]

  @@unique([provider, externalId])
  @@index([competitionId])
}

/// GKP | DEF | MID | FWD — kept as a plain string because SQLite has no enum
/// type; validated at the application boundary (lib/competitions).
model Player {
  id            String      @id @default(cuid())
  provider      String
  externalId    String // provider's player id
  slug          String      @unique
  firstName     String
  lastName      String
  displayName   String // short/display name shown in the UI
  position      String
  status        String // "a" available, "i" injured, "s" suspended, ...
  /// FPL's own numeric availability signal — 0/25/50/75/100, or null.
  /// See docs/PLAYER_AVAILABILITY_IMPLEMENTATION.md §1: verified against
  /// live data to be fully redundant with `status` except when status is
  /// "d" (doubtful), where it is the only place a graded distinction
  /// (25/50/75) exists. Always refreshed on ingestion — this is FPL's
  /// current live figure, never a historical snapshot.
  chanceOfPlayingNextRound Int?
  /// Provider's photo asset code (see lib/assets) — an identity/imagery
  /// field, not an analytical statistic.
  photoCode     String?
  /// The country a player represents internationally (e.g. "England",
  /// "Spain") — NOT necessarily the same as legal citizenship (an English
  /// player's citizenship is "United Kingdom", but their football
  /// nationality is "England"). Sourced from Wikidata's P1532 "country for
  /// sport" property via a separate, occasional enrichment script
  /// (scripts/enrich-nationality.ts) — deliberately NOT derived from FPL's
  /// own undocumented `region` integer, which has no reliable public
  /// mapping to countries. Null whenever we don't have a high-confidence
  /// match: no flag shown is preferred over a guessed one.
  nationality     String?
  /// Flag icon code for `nationality`, matching the `flag-icons` npm
  /// package's codes — an ISO 3166-1 alpha-2 code (e.g. "es", "br") or,
  /// for the UK's four football nations specifically, "gb-eng" | "gb-sct"
  /// | "gb-wls" | "gb-nir" (England/Scotland/Wales/Northern Ireland have
  /// no ISO 3166-1 code of their own, since they aren't sovereign states).
  nationalityCode String?
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])

  performances PlayerMatchPerformance[]
  newsItems    NewsItem[]

  @@unique([provider, externalId])
  @@index([teamId])
}

model Match {
  id            String      @id @default(cuid())
  provider      String
  externalId    String // provider's fixture id
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  seasonId      String
  season        Season      @relation(fields: [seasonId], references: [id])
  gameweek      Int?
  kickoff       DateTime
  status        String // "scheduled" | "finished"
  homeTeamId    String
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    String
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore     Int?
  awayScore     Int?

  playerPerformances PlayerMatchPerformance[]
  teamPerformances   TeamMatchPerformance[]
  newsItems          NewsItem[]

  @@unique([provider, externalId])
  @@index([seasonId])
  @@index([kickoff])
}

model TeamMatchPerformance {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id])
  teamId     String
  team       Team   @relation(fields: [teamId], references: [id])
  isHome     Boolean
  goalsFor   Int
  goalsAgainst Int
  result     String // "W" | "D" | "L"

  @@unique([matchId, teamId])
  @@index([teamId])
}

/// One row per player per match. Populated in two passes by ingestion:
/// fixture-level event attribution first (goals/assists/cards/bonus), then
/// gameweek-level detail (minutes/xG/xA/defensive actions) — see
/// lib/ingestion/fpl. Fields default to 0 until both passes have run.
model PlayerMatchPerformance {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id])
  teamId   String

  minutes             Int     @default(0)
  /// From FPL's per-gameweek `starts` flag — whether this player started
  /// the match (vs. appeared as a substitute). See
  /// docs/MATCH_CENTRE_DATA_AUDIT.md §3 "Lineups" — available from the
  /// provider but unused until the Match Centre needed a Starting XI.
  started             Boolean @default(false)
  goals               Int     @default(0)
  assists             Int     @default(0)
  cleanSheets         Int     @default(0)
  goalsConceded       Int     @default(0)
  yellowCards         Int     @default(0)
  redCards            Int     @default(0)
  saves               Int     @default(0)
  bonus               Int     @default(0)
  bps                 Int     @default(0)
  expectedGoals       Float   @default(0)
  expectedAssists     Float   @default(0)
  expectedGoalsConceded Float @default(0)
  defensiveActions    Float   @default(0) // FPL "defensive contribution" proxy (CBI/tackles/recoveries)
  ictIndex            Float   @default(0)

  /// Component breakdown of `defensiveActions` above — tackles, clearances/
  /// blocks/interceptions, and ball recoveries, each reported separately by
  /// FPL's per-gameweek live endpoint but previously discarded on
  /// ingestion. See docs/PLAYER_INTELLIGENCE_ACCURACY_AUDIT.md §9. Nullable
  /// with NO default: null means "not yet captured for this row" (every
  /// row ingested before this field existed), never "known to be zero" —
  /// existing analytics do not read these fields at all; they exist purely
  /// as richer raw data for a future, separate methodology review.
  tackles                       Int?
  clearancesBlocksInterceptions Int?
  recoveries                    Int?

  updatedAt DateTime @updatedAt

  @@unique([playerId, matchId])
  @@index([matchId])
}

/// A raw, unmodified snapshot of a provider payload — kept for traceability
/// and to make schema drift a diff instead of a silent break. Not read by
/// the analytics engine.
model RawIngestionPayload {
  id         String   @id @default(cuid())
  provider   String
  endpoint   String
  fetchedAt  DateTime @default(now())
  payload    String // JSON, stored as text (SQLite has no native JSON type)

  @@index([provider, endpoint, fetchedAt])
}

/// One row per ingestion task run — powers "data last updated" in the UI
/// and gives operators a simple audit trail without a full job queue.
model IngestionLog {
  id              String   @id @default(cuid())
  provider        String
  task            String // e.g. "teams", "players", "fixtures", "gameweek-stats"
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  status          String // "running" | "success" | "failed"
  recordsWritten  Int      @default(0)
  message         String?

  @@index([provider, task, startedAt])
}

/// NEWS LAYER — Phase 1. See docs/NEWS_LAYER_RESEARCH.md for why this
/// starts narrower than a general multi-publisher news feed: every
/// commercial news API and reputable RSS feed investigated either forbids
/// production/commercial use on its free tier or requires a paid business
/// licence for exactly this kind of redistribution. Phase 1 is built
/// entirely on FPL's own player `news`/`news_added` fields instead — data
/// already inside this project's existing, legitimate FPL relationship,
/// with exact (not fuzzy) player association by construction.
///
/// Deliberately shaped as a generic "news item" (provider/category/title/
/// description/url/imageUrl/sourceName/publishedAt + optional player/team/
/// match associations) rather than an FPL-specific table, so a future,
/// separately-licensed editorial source (see the research doc's §7) can
/// reuse this same model without a schema rewrite — `url`/`imageUrl` are
/// nullable specifically because FPL's own notes have neither.
model NewsItem {
  id       String @id @default(cuid())
  /// "fpl" for Phase 1. A future licensed source would use its own value
  /// here (e.g. "guardian") — never mixed with FPL's own semantics.
  provider String
  /// Dedup / idempotency key, unique per provider. For FPL: playerId +
  /// the exact news_added timestamp, so an unchanged note is never
  /// re-inserted, and an updated note (new news_added) creates a new,
  /// distinct historical row rather than overwriting the old one.
  externalId String

  /// "injury" | "suspension" | "transfer" | "availability" | "general" —
  /// see docs/NEWS_LAYER_RESEARCH.md §6 for which of these FPL's own data
  /// can actually support today. Never invented beyond what the source
  /// evidences.
  category    String
  /// A short, synthesized label (e.g. "Injury update") — FPL provides no
  /// headline of its own, so this is generated from `category`, not from
  /// any external editorial source. Kept distinct from `description` so a
  /// future editorial source's real headline fits the same field.
  title       String
  /// The actual source text — for FPL, exactly the `news` field, verbatim,
  /// never paraphrased or embellished.
  description String
  /// Nullable: FPL's notes don't link to an external article.
  url         String?
  /// Nullable: FPL's notes carry no image.
  imageUrl    String?
  /// Human-readable attribution shown in the UI — "Fantasy Premier League"
  /// for Phase 1. Every news item must be able to show where it came from.
  sourceName  String
  /// When the underlying source considers this current — FPL's
  /// `news_added` for Phase 1. Drives freshness windows; never defaults to
  /// "now" for older source data.
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Associations are deliberately optional and independent — a news item
  /// may relate to a player, a team, a match, or (rare, not used in Phase
  /// 1) none of these. Never inferred beyond what the source directly
  /// evidences — see docs/NEWS_LAYER_RESEARCH.md on entity matching.
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id])
  matchId  String?
  match    Match?  @relation(fields: [matchId], references: [id])

  @@unique([provider, externalId])
  @@index([playerId])
  @@index([teamId])
  @@index([matchId])
  @@index([publishedAt])
}
