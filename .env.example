# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# PostgreSQL connection string (local dev and production each use their own
# database — see README.md "Deployment"). Prisma 7 reads this from
# prisma.config.ts, not from prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secures /api/ingest (see app/api/ingest/route.ts and vercel.json).
# Generate a real random value for both local dev and Vercel — e.g.
# `openssl rand -hex 32` — and set it in Vercel's project environment
# variables too; Vercel then sends it automatically as a Bearer token on
# cron-triggered requests.
CRON_SECRET="a-random-secret-value"
